# LLM provider for AI features (choose one — leave both empty for graceful degradation)
ANTHROPIC_API_KEY=
# or
OPENAI_API_KEY=

# Repliers MLS API (https://repliers.io — attach a South Florida MLS board in your Repliers dashboard)
# Once a Florida MLS feed is connected, paste the API key here and restart the dev server.
REPLIERS_API_KEY=

# Maps (optional — for property map view)
NEXT_PUBLIC_MAPS_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
